# GEMINI_API_KEY: Server-side API key for AIRWISE AI assistant and personalized daily routine generation.
# Never expose this variable with a VITE_ prefix or in frontend bundles.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# PORT: Port for the Express + Vite server (default 3000).
PORT=3000

# APP_URL: Deployed origin URL used for CORS allowlisting and self-referential links.
APP_URL="http://localhost:3000"

# ALLOWED_ORIGINS: Optional comma-separated list of additional trusted origins for CORS.
ALLOWED_ORIGINS=""

# TRUST_PROXY: Express reverse-proxy trust ("false" for direct deployments, "1" behind 1 load balancer hop).
# Automatically defaults to 1 on Cloud Run (K_SERVICE) and false locally.
TRUST_PROXY="false"

# FRAME_ANCESTORS: Optional comma-separated additional trusted origins allowed to embed the app in an iframe.
FRAME_ANCESTORS=""

# NODE_ENV: "development" or "production"
NODE_ENV="development"

